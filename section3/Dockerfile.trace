# Diagnostic image based on the existing application image
FROM ia462-lab4

# Install strace for syscall monitoring
USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends strace && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Trace the Flask application
CMD ["strace", "-f", "-c", "python3", "app/app.py"]